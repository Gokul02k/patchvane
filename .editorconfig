# What the files here already look like, written down so an editor follows it.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 79

[*.{js,css,html,svg}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.sh]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = false
trim_trailing_whitespace = false
