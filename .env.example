# Nothing here identifies a person: whoever signs up gets a dashboard of
# their own patches, so there is no address to set. Every setting below has
# a working default, so there is nothing you have to fill in to start.
#
# ./run.sh copies this to .env itself on a first run and generates the
# secret, so the whole of the setup is:
#
#   ./run.sh

# Signs the session cookie. Any long random string; changing it signs
# everybody out.
#   openssl rand -hex 32
export PATCHVANE_SECRET=

# Signing up sends a six digit code to the address somebody gives, and
# reading it back is what proves the address is theirs. On this machine you
# need no provider for that: with none of the keys below set, the code is
# written to the terminal the server is running in.
#
# Anything the internet can reach needs a real way to send. The free one is
# your own Gmail: deploy/gmail-relay.gs is an Apps Script web app that sends
# through your own account, so there is no provider, no card, no domain, and
# the mail is signed by Google like anything else you send. The script says
# how to deploy it; docs/deploying.md has the longer version.
# export PATCHVANE_GAS_URL=https://script.google.com/macros/s/..../exec
# export PATCHVANE_GAS_SECRET=
# export PATCHVANE_URL=https://patchvane.example.com

# Or a provider. Mailjet's free plan is 200 a day with no card and a single
# sender address to verify. Brevo, Resend, SendGrid and Mailgun are here
# too, and plain SMTP for hosts that allow outbound 587.
# export PATCHVANE_MAILJET_KEY=
# export PATCHVANE_MAILJET_SECRET=
# export PATCHVANE_MAIL_FROM=the address your provider has verified
# export PATCHVANE_BREVO_KEY=
# export PATCHVANE_RESEND_KEY=
# export PATCHVANE_SENDGRID_KEY=
# export PATCHVANE_MAILGUN_KEY=
# export PATCHVANE_MAILGUN_DOMAIN=
# export PATCHVANE_SMTP_HOST=
# export PATCHVANE_SMTP_USER=
# export PATCHVANE_SMTP_PASSWORD=

# Narrow accounts to particular addresses. A bare @domain allows everybody
# there. Leave unset to let anyone sign up with an address they can read.
# export PATCHVANE_ALLOW_EMAILS=someone@kernel.org,@amd.com

# Stop new accounts without touching the ones that exist.
# export PATCHVANE_ALLOW_SIGNUP=0

# Where to listen, and how often to collect. 0.0.0.0 exposes it to the
# network, so only with a proxy and PATCHVANE_MODE=cloud in front.
export PATCHVANE_HOST=127.0.0.1
export PATCHVANE_PORT=8787
export PATCHVANE_INTERVAL=30

# The timer collects only for people signed in at the time. This is how long
# after somebody's last page view they still count as signed in.
# export PATCHVANE_ACTIVE_MINUTES=30

# How long a sign-in lasts before the login page asks again.
export PATCHVANE_SESSION_HOURS=12

# Stopping and starting the server signs everybody out. That is what
# stopping it looks like it should mean on a machine you run for
# yourself. Turn it off for something deployed, where restarting to pick
# up a new version should not throw everyone back to the login page.
export PATCHVANE_SIGN_OUT_ON_RESTART=1

# Set this and sign-ins survive restarts regardless of the line above.
# Change the value to sign everybody out at once.
# export PATCHVANE_SESSION_EPOCH=1

# Wrong passwords from one address before it is made to wait. A correct one
# is never counted.
export PATCHVANE_LOGIN_TRIES=5

# Codes one address may have sent in fifteen minutes.
# export PATCHVANE_MAIL_TRIES=8

# On a network that opens TLS and re-signs it, point Python at the
# certificate doing that, or nothing can be read and every collection
# comes back empty. python3 netcheck.py says whether this is you.
# Trusting it system wide with update-ca-certificates is tidier; this is
# for when you cannot.
# export SSL_CERT_FILE=/path/to/your-ca.pem

# Assistant keys. Any one is enough; more means it can fail over between
# them. They can also be typed into Settings instead of kept here.
# export GEMINI_API_KEY=
# export OPENAI_API_KEY=
# export ANTHROPIC_API_KEY=
