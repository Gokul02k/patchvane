# Patchvane, behind a proxy that terminates TLS.
#
# The checkout in /opt/patchvane is code and stays read-only to the service;
# everything written at run time goes to /var/lib/patchvane, which is what
# PATCHVANE_DATA_DIR points at.  A deploy replaces the first and never
# touches the second.

[Unit]
Description=Patchvane, an upstream patch tracker
Documentation=https://github.com/SelamHemanth/patchvane
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=patchvane
Group=patchvane
WorkingDirectory=/opt/patchvane
EnvironmentFile=/etc/patchvane/patchvane.env

# Bound to localhost on purpose.  Caddy is the only thing that should be able
# to reach it, so the port is not open to the internet even if the firewall is
# wrong.
ExecStart=/usr/bin/python3 /opt/patchvane/src/serve.py --host 127.0.0.1 --port 8787

# Refuse to start on a configuration that would be unsafe, rather than serving
# with a cookie nobody signed.
ExecStartPre=/usr/bin/python3 /opt/patchvane/src/serve.py --check

Restart=always
RestartSec=3
# serve.py handles SIGTERM and closes the socket on the way out.
KillSignal=SIGTERM
TimeoutStopSec=20

# Vaults are mode 0600 and should stay that way whatever the umask inherits.
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/patchvane
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# Outbound HTTPS to the archives, and to the mail provider that carries the
# sign-up codes.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=patchvane

[Install]
WantedBy=multi-user.target
